# App env. Copy to .env and fill. Never commit the real .env.

# ---------- Database ----------
# We connect to an EXISTING Postgres on the VM (managed by a separate
# docker-compose). The `borderless` database is created once via
# scripts/vm-init-borderless.sql.
#
# IMPORTANT: if the password contains special characters, URL-encode them.
#   '@' -> '%40'   ':' -> '%3A'   '/' -> '%2F'   '#' -> '%23'
# Example: password 'X3dres_ecHA@' becomes 'X3dres_ecHA%40' below.
DATABASE_URL=postgresql+asyncpg://radar:<URL_ENCODED_PASSWORD>@<VM_HOST>:5433/borderless

# ---------- Slack ----------
# Ops receive 20/80/7-day alerts here.
SLACK_WEBHOOK_URL=

# ---------- Gemini LLM ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---------- Inbound API auth ----------
# Clients send: Authorization: <API_AUTH_KEY>  (bare token, no Bearer)
API_AUTH_KEY=

# ---------- Self-reference ----------
API_URL=http://localhost:8000

# ---------- External callback (optional) ----------
# We POST 20/80/7-day checkpoint payloads here. Leave blank to skip.
EXTERNAL_CALLBACK_URL=
EXTERNAL_CALLBACK_KEY=

# ---------- 7-day timeout sweep ----------
SEVEN_DAY_JOB_ENABLED=true
SEVEN_DAY_JOB_INTERVAL_MINUTES=60

# ---------- ClickHouse (read-only) ----------
# Used by the rad_slot_status feature: T1 (fetch other_details on rad
# onboard) and T2 (presence-based slot compliance cron). Empty host
# disables both features cleanly. Read access only — never written to.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_S=30

# ---------- Slot-compliance cron (T2) ----------
# Default ON. Each tick scores slots whose end falls in (now-lookback, now]
# IST. The tick is a no-op when no rads have other_details populated yet.
SLOT_COMPLIANCE_JOB_ENABLED=true
SLOT_COMPLIANCE_JOB_CRON_HOURS=0,6,12,18
SLOT_COMPLIANCE_JOB_TIMEZONE=Asia/Kolkata
SLOT_COMPLIANCE_LOOKBACK_HOURS=6

# ---------- Zero-touch deploy automation ----------
# At app startup:
#   1. AUTO_MIGRATE_ON_STARTUP runs `alembic upgrade head`. Idempotent.
#   2. STARTUP_BACKFILL_ENABLED schedules a one-shot background backfill
#      that (a) populates other_details for any rad with NULL,
#      (b) runs one deep slot_compliance tick covering the lookback below.
#   Both are idempotent — safe to run on every boot.
AUTO_MIGRATE_ON_STARTUP=true
STARTUP_BACKFILL_ENABLED=true
STARTUP_BACKFILL_LOOKBACK_HOURS=720
